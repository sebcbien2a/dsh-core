# Environnements virtuels et cache Python
.venv-v3/
__pycache__/
*.pyc

# Bases de données locales (Ne jamais versionner les datas)
qdrant_storage/
neo4j_data/
/langfuse_db/
/n8n_data/

# Poids des modèles IA (Fichiers massifs)
models/
*.gguf
*.bin

# Fichiers sensibles (Clés API OpenRouter, Mem0, etc.)
.env

# Résultats locaux du benchmark OCR
benchmarks/results/*.json
!benchmarks/results/.gitkeep

benchmarks/data/ocr_baseline_texts.json

# Client exports and their aggregate structure reports
workspace/imports/clients/*.xml
workspace/imports/clients/*_report.json
workspace/imports/tariffs/*_report.json
workspace/imports/tariffs/*_review.xlsx
workspace/imports/tariffs/*_anomalies.json
workspace/imports/tariffs/*_audit.json
