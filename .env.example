# Valeurs modifiables sans changement de code.
# Aucun secret réel ne doit être versionné.
AI_MODE=hybrid

# Modèle local rapide à sélectionner après validation ; aucun fallback implicite.
LOCAL_FAST_MODEL=
LOCAL_BASE_MODEL=qwen3.5:9b
# Modèle Vision local à sélectionner après validation ; aucun fallback implicite.
LOCAL_VISION_MODEL=
LOCAL_OCR_ENGINE=PaddleOCR
LOCAL_EXTRACTION_MODEL=numind/nuextract3:q4_k_m
# auto = schema JSON strict -> json -> none ; forcer schema|json|none si besoin.
LOCAL_EXTRACTION_FORMAT_MODE=auto
LOCAL_EMBEDDING_MODEL=nomic-embed-text:latest

# Nemotron : préparation, décomposition, RAG courant et review.
CLOUD_PREPARATION_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# MiMo : expert principal, image, audio, vidéo et coding.
CLOUD_EXPERT_MODEL=xiaomi/mimo-v2.6-pro
CLOUD_VISION_MODEL=xiaomi/mimo-v2.6-pro
CLOUD_CODING_MODEL=xiaomi/mimo-v2.6-pro
CLOUD_REVIEW_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# DeepSeek : premier fallback agentique.
CLOUD_AGENTIC_FALLBACK_MODEL=deepseek/deepseek-v4.1-flash
# Gemini : super-superviseur multimodal (escalade ultime stricte sur échec d'ancrage schéma).
CLOUD_MULTIMODAL_FALLBACK_MODEL=google/gemini-3.8-flash

# Persistance Neo4j (mot de passe à fournir dans .env, jamais versionné).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Aucun secret réel dans ce fichier.
OPENROUTER_API_KEY=
